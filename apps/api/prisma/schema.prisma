generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id          String    @id @default(cuid())
  email       String    @unique
  passwordHash String
  username    String    @unique
  displayName String
  bio         String    @default("")
  avatarUrl   String?
  createdAt   DateTime  @default(now())
  posts       Post[]
  comments    Comment[]
  likes       Like[]
  following   Follow[]  @relation("following")
  followers   Follow[]  @relation("followers")
  hostedRooms LiveRoom[] @relation("liveHosts")
  liveMembers LiveParticipant[]
  liveMessages LiveMessage[]
}
model Post {
  id        String    @id @default(cuid())
  text      String    @default("") @db.VarChar(2000)
  imageUrl  String?
  videoUrl  String?
  createdAt DateTime  @default(now())
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes     Like[]
  comments  Comment[]
  @@index([createdAt])
}
model Like {
  userId String
  postId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@id([userId, postId])
}
model Comment {
  id        String   @id @default(cuid())
  text      String   @db.VarChar(1000)
  createdAt DateTime @default(now())
  authorId  String
  postId    String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@index([postId, createdAt])
}
model Follow {
  followerId String
  followingId String
  follower User @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)
  @@id([followerId, followingId])
}

model UploadedMedia {
  id        String   @id @default(cuid())
  ownerId   String
  kind      String
  fileName  String   @unique
  createdAt DateTime @default(now())
  @@index([ownerId, createdAt])
}

enum LiveRoomStatus {
  LIVE
  ENDED
}

model LiveRoom {
  id         String         @id @default(cuid())
  channel    String         @unique
  title      String         @db.VarChar(120)
  status     LiveRoomStatus @default(LIVE)
  hostId     String
  host       User           @relation("liveHosts", fields: [hostId], references: [id], onDelete: Cascade)
  startedAt  DateTime       @default(now())
  endedAt    DateTime?
  participants LiveParticipant[]
  messages LiveMessage[]
  @@index([status, startedAt])
  @@index([hostId, status])
}

model LiveParticipant {
  roomId     String
  userId     String
  agoraUid   Int
  joinedAt   DateTime @default(now())
  room       LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([roomId, userId])
  @@unique([roomId, agoraUid])
}

model LiveMessage {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  text      String   @db.VarChar(250)
  createdAt DateTime @default(now())
  room      LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([roomId, createdAt])
}

generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum UserRole {
  USER
  ADMIN
}

model User {
  role        UserRole @default(USER)
  id          String    @id @default(cuid())
  email       String    @unique
  passwordHash String
  username    String    @unique
  displayName String
  bio         String    @default("")
  avatarUrl   String?
  createdAt   DateTime  @default(now())
  posts       Post[]
  comments    Comment[]
  likes       Like[]
  following   Follow[]  @relation("following")
  followers   Follow[]  @relation("followers")
  hostedRooms LiveRoom[] @relation("liveHosts")
  liveMembers LiveParticipant[]
  liveMessages LiveMessage[]
  guestSeats LiveGuestSeat[]
}
model Post {
  id        String    @id @default(cuid())
  text      String    @default("") @db.VarChar(2000)
  imageUrl  String?
  videoUrl  String?
  createdAt DateTime  @default(now())
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes     Like[]
  comments  Comment[]
  @@index([createdAt])
}
model Like {
  userId String
  postId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@id([userId, postId])
}
model Comment {
  id        String   @id @default(cuid())
  text      String   @db.VarChar(1000)
  createdAt DateTime @default(now())
  authorId  String
  postId    String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@index([postId, createdAt])
}
model Follow {
  followerId String
  followingId String
  follower User @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)
  @@id([followerId, followingId])
}

model UploadedMedia {
  id        String   @id @default(cuid())
  ownerId   String
  kind      String
  fileName  String   @unique
  createdAt DateTime @default(now())
  @@index([ownerId, createdAt])
}

enum LiveRoomStatus {
  LIVE
  ENDED
}

model LiveRoom {
  id         String         @id @default(cuid())
  channel    String         @unique
  title      String         @db.VarChar(120)
  status     LiveRoomStatus @default(LIVE)
  hostId     String
  host       User           @relation("liveHosts", fields: [hostId], references: [id], onDelete: Cascade)
  startedAt  DateTime       @default(now())
  endedAt    DateTime?
  participants LiveParticipant[]
  messages LiveMessage[]
  guestSeats LiveGuestSeat[]
  bans LiveRoomBan[]
  reports LiveReport[]
  @@index([status, startedAt])
  @@index([hostId, status])
}

model LiveParticipant {
  roomId     String
  userId     String
  agoraUid   Int
  joinedAt   DateTime @default(now())
  room       LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([roomId, userId])
  @@unique([roomId, agoraUid])
}

model LiveMessage {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  text      String   @db.VarChar(250)
  createdAt DateTime @default(now())
  room      LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([roomId, createdAt])
}

enum LiveSeatStatus {
  REQUESTED
  INVITED
  ACTIVE
  DECLINED
  REMOVED
}

model LiveGuestSeat {
  id         String @id @default(cuid())
  roomId     String
  userId     String
  status     LiveSeatStatus
  seatNumber Int?
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
  room       LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([roomId, userId])
  @@unique([roomId, seatNumber])
  @@index([roomId, status])
}

model LiveRoomBan {
  roomId String
  userId String
  reason String? @db.VarChar(250)
  createdAt DateTime @default(now())
  room LiveRoom @relation(fields:[roomId], references:[id], onDelete:Cascade)
  @@id([roomId,userId])
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

model LiveReport {
  id String @id @default(cuid())
  roomId String
  reporterId String
  subjectId String?
  reason String @db.VarChar(250)
  status ReportStatus @default(OPEN)
  reviewNote String? @db.VarChar(1000)
  reviewedById String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  room LiveRoom @relation(fields:[roomId],references:[id],onDelete:Cascade)
  @@index([roomId,createdAt])
  @@index([subjectId,createdAt])
  @@index([status,createdAt])
}

/*
 * PRE-REVENUE DEMO ECONOMY: all values are internal, non-redeemable points.
 * No purchased coins, cash value, payout or withdrawal is implemented.
 */
model RivoWallet {
  userId       String @id
  coins        Int    @default(0)
  creatorPoints Int   @default(0)
  agencyPoints Int    @default(0)
  updatedAt    DateTime @updatedAt
}

model RivoLedgerEntry {
  id          String   @id @default(cuid())
  userId      String
  walletType  String
  delta       Int
  kind        String
  operationId String
  createdAt   DateTime @default(now())
  @@unique([userId, walletType, operationId])
  @@index([userId, createdAt])
}

model RivoGift {
  id             String @id @default(cuid())
  senderId       String
  recipientId    String
  roomId         String
  giftCode       String
  costCoins      Int
  creatorPoints  Int
  agencyPoints   Int
  platformPoints Int
  agencyId       String?
  battleId       String?
  idempotencyKey String
  createdAt      DateTime @default(now())
  @@unique([senderId, idempotencyKey])
  @@index([roomId, createdAt])
  @@index([recipientId, createdAt])
}

enum RivoBattleStatus {
  ACTIVE
  ENDED
}

model RivoBattle {
  id         String @id @default(cuid())
  roomId     String
  hostId     String
  guestId    String
  hostScore  Int @default(0)
  guestScore Int @default(0)
  status     RivoBattleStatus @default(ACTIVE)
  startedAt  DateTime @default(now())
  endsAt     DateTime
  endedAt    DateTime?
  @@index([roomId, status])
}

model RivoAgency {
  id        String @id @default(cuid())
  ownerId   String
  name      String @db.VarChar(100)
  createdAt DateTime @default(now())
  members   RivoAgencyMember[]
  @@index([ownerId])
}

enum RivoAgencyMemberStatus {
  INVITED
  ACTIVE
}

model RivoAgencyMember {
  creatorId String @id
  agencyId  String
  status    RivoAgencyMemberStatus @default(INVITED)
  joinedAt  DateTime?
  agency    RivoAgency @relation(fields:[agencyId],references:[id],onDelete:Cascade)
  @@index([agencyId,status])
}
